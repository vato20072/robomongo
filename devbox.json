{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": {
    "cmake": "3.31.7",
    "git": "latest",
    "pkg-config": "latest",
    "python": "3.9",
    "mongosh": "latest",
    "openssl_1_1": {
      "version": "1.1.1w",
      "outputs": ["bin", "dev", "out"],
      "allow_insecure": ["openssl-1.1.1w"]
    },
    "qt5.full": {
      "version": "latest",
      "platforms": ["x86_64-linux", "aarch64-linux"]
    },
    "qt5.qtbase": {
      "version": "latest",
      "outputs": ["bin", "dev", "out"],
      "platforms": ["x86_64-darwin", "aarch64-darwin"]
    },
    "qt5.qtmacextras": {
      "version": "latest",
      "platforms": ["x86_64-darwin", "aarch64-darwin"]
    }
  },
  "env": {
    "ROBO_DEVBOX": "1"
  },
  "shell": {
    "init_hook": ["source ./devbox.d/init.sh"],
    "scripts": {
      "shell-clone": "git clone --branch roboshell-v4.2 https://github.com/paralect/robomongo-shell.git \"$ROBOSHELL_DIR\"",
      "shell-build": "cd \"$ROBOSHELL_DIR\" && bin/build",
      "configure": "bin/configure",
      "build": "bin/build",
      "run": "bin/run",
      "clean": "bin/clean"
    }
  }
}

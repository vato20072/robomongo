{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": {
    "cmake":      "3.31.7",
    "git":        "latest",
    "pkg-config": "latest",
    "mongosh":    "latest",
    "openssl_1_1": {
      "version":        "1.1.1w",
      "outputs":        ["bin", "dev", "out"],
      "allow_insecure": ["openssl-1.1.1w"]
    },
    "qt5.full": {
      "version":   "latest",
      "platforms": ["x86_64-linux", "aarch64-linux"]
    },
    "qt5.qtbase": {
      "version":   "latest",
      "outputs":   ["bin", "dev", "out"],
      "platforms": ["x86_64-darwin", "aarch64-darwin"]
    },
    "qt5.qtmacextras": {
      "version":   "latest",
      "platforms": ["x86_64-darwin", "aarch64-darwin"]
    },
    "boost": {
      "version": "latest",
      "outputs": ["out", "dev"]
    }
  },
  "env": {
    "ROBO_DEVBOX": "1"
  },
  "shell": {
    "init_hook": ["source ./devbox.d/init.sh"],
    "scripts": {
      "configure": "bin/configure",
      "build":     "bin/build",
      "install":   "bin/install",
      "pack":      "bin/pack",
      "run":       "bin/run",
      "clean":     "bin/clean"
    }
  }
}
